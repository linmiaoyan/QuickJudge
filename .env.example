# 复制为 .env 后填入真实密钥，切勿提交 .env

# 方式一：MiniMax 接口（批阅、译文均使用）
# MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M2.5

# 方式二：OpenAI 兼容接口（优先于 MiniMax），如阿里云百炼、CodingPlan 等
# 阿里云百炼（通义千问，支持 qwen3.5-plus 图像理解 / 作文批改）示例：
# LLM_API_KEY=sk-你的百炼API密钥
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.5-plus
# 其他服务商请替换为对应 base_url 和 model
# LLM_API_KEY=your_key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 并行批阅（可选，留空用默认值）
# LLM_BATCH_WORKERS=6      # 一批里同时批几份，实测 6 最稳
# LLM_MAX_CONCURRENCY=8    # 全账号在飞请求上限，多个班同时跑时共用
# LLM_IMG_MAX_DEFAULT=2400 # 送图长边上限（普通卷）
# LLM_IMG_MAX_HARD=3300    # 送图长边上限（难卷升档用，需扫描 dpi ≥ 300）
